{
    "enabledMcpjsonServers": ["context7"],
    "permissions": {
        "allow": [
            "mcp__context7__*",
            "Read",
            "Glob",
            "Grep",
            "Agent",
            "WebSearch",
            "WebFetch(domain:crates.io)",
            "WebFetch(domain:v2.tauri.app)",
            "WebFetch(domain:schema.tauri.app)",
            "WebFetch(domain:docs.rs)",
            "WebFetch(domain:github.com)",
            "WebFetch(domain:webgpufundamentals.org)",
            "WebFetch(domain:gist.github.com)",
            "WebFetch(domain:man.archlinux.org)",
            "WebFetch(domain:k2-fsa.github.io)",
            "WebFetch(domain:specta.dev)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(ls:*)",
            "Bash(find:*)",
            "Bash(cat:*)",
            "Bash(head:*)",
            "Bash(tail:*)",
            "Bash(grep:*)"
        ]
    },
    "hooks": {
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "echo 'INSTRUCTION: If the prompt matches any available skill keywords, you MUST first activate the skill using Skill(skill-name)'"
                    }
                ]
            }
        ]
    }
}
